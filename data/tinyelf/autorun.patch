+#ifdef TINYELF_AUTORUN
+/*
+ 	TinyELF autorun: a BASIC listing built into the ROM, entered and RUN at
+ 	power-on, so the cartridge works on its own - no KeyPortari, no SaveKey.
+ 	Build with  make AUTORUN=game.bas  (or -DTINYELF_AUTORUN='"game.bas"').
+ 	The listing is plain text like a LIST "En:file" export; .incbin puts it
+ 	into .rodata as it is, the trailing line end makes sure the last line
+ 	is stored too. Only the tokenized program takes BASIC memory, the text
+ 	itself stays in flash.
+*/
+__asm__(".section .rodata\n"
+        ".global autorunprogram\n"
+        "autorunprogram:\n"
+        ".incbin \"" TINYELF_AUTORUN "\"\n"
+        ".byte 10, 0\n"
+        ".previous\n");
+extern const char autorunprogram[];
+static void enterchars(const uint8_t *chars, uint16_t count); /* further down, next to xenter() */
+#endif
+
 /* autorun something from EEPROM or a filesystem */
 char autorun() {
 #ifdef EEPROMMEMINTERFACE
@@ -2161,6 +2181,37 @@ char autorun() {
   }
 #endif
 
+  /* the listing built into the ROM: entered like ENTER does, then RUN.
+     When it ends (END, an error or ESC) the interpreter shows READY with
+     the program still in memory, so it can be listed and changed */
+#ifdef TINYELF_AUTORUN
+  {
+    const char *line = autorunprogram, *end;
+
+    iodefaults(); /* loop() only sets id/od after a run, ESC needs them now */
+
+    /* line by line, with a frame after each one: storing a line is not
+       free, and a long listing must not keep the 6507 waiting in overblank
+       for many frames (Gopher2600 stops the ARM after 1.5M cycles) */
+    bi = ibuffer + 1;
+    while (*line && er == 0) {
+      for (end = line; *end && *end != '\n'; end++);
+      if (*end) end++;
+      enterchars((const uint8_t *)line, (uint16_t)(end - line));
+      byield();
+      line = end;
+    }
+    ibuffer[0] = 0;
+    ibuffer[1] = 0;
+    bi = ibuffer + 1;
+    if (er == 0 && top > 0) {
+      st = SRUN;
+      return 1;
+    }
+    er = 0;
+  }
+#endif

{
  "vcstheme": 1,
  "name": "Light",
  "palette": {
    "bg": "#F3F3F3",
    "panel": "#E6E6E6",
    "text": "#1E1E1E",
    "accent": "#0066CC",
    "code": "#FFFFFF"
  },
  "colours": {
    "ui.background": "$bg",
    "ui.panel": "$panel",
    "ui.popup": "#FFFFFFF5",
    "ui.text": "$text",
    "ui.textDim": "#707070",
    "ui.border": "#00000030",
    "ui.frame": "#FFFFFF",
    "ui.frameHover": "$accent/22",
    "ui.frameActive": "$accent/38",
    "ui.title": "$panel",
    "ui.titleActive": "#DCDCDC",
    "ui.button": "#DFDFDF",
    "ui.buttonHover": "$accent/40",
    "ui.buttonActive": "$accent/70",
    "ui.header": "$accent/30",
    "ui.headerHover": "$accent/48",
    "ui.headerActive": "$accent/70",
    "ui.tab": "$panel",
    "ui.tabSelected": "$bg",
    "ui.tabHover": "$accent/30",
    "ui.accent": "$accent",
    "ui.accentHover": "#3D8FE0",
    "ui.scrollbar": "#00000010",
    "ui.scrollbarGrab": "#BDBDBD",
    "ui.scrollbarGrabHover": "#9E9E9E",
    "ui.tableHeader": "#E0E0E0",
    "ui.tableRowAlt": "#0000000A",
    "ui.link": "$accent",
    "ui.selection": "$accent/40",
    "ui.dockPreview": "$accent/80",
    "ui.modalDim": "#30303050",
    "editor.background": "$code",
    "editor.text": "#1F1F1F",
    "editor.currentLine": "#F0F4FA",
    "editor.selection": "#ADD6FF",
    "editor.cursor": "#000000",
    "editor.match": "#FFD54F80",
    "editor.matchCurrent": "#F5A62399",
    "editor.errorLine": "#FF00001E",
    "editor.warningLine": "#FFB4002E",
    "editor.gutter": "$code",
    "editor.gutterBorder": "#E0E0E0",
    "editor.lineNumber": "#A0A0A0",
    "editor.lineNumberCurrent": "#303030",
    "editor.errorNumber": "#D03030",
    "editor.warningNumber": "#B07800",
    "editor.breakpoint": "#E04040",
    "editor.cycles": "#8A7A30",
    "editor.indentGuide": "#00000020",
    "editor.link": "$accent",
    "syntax.comment": "#008000",
    "syntax.string": "#A31515",
    "syntax.number": "#098658",
    "syntax.mnemonic": "#0000FF",
    "syntax.illegal": "#AF00DB",
    "syntax.unstable": "#E00000",
    "syntax.register": "#267F99",
    "syntax.directive": "#795E26",
    "syntax.label": "#001080",
    "syntax.symbol": "@editor.text",
    "messages.error": "#C62828",
    "messages.warning": "#A86400",
    "messages.info": "#1565C0",
    "messages.ok": "#2E7D32",
    "messages.highlight": "#8A6D00",
    "messages.name": "#00796B",
    "space.ok": "#3C9A4A",
    "space.warning": "#D9A21B",
    "space.full": "#D03A3A",
    "graphics.grid": "#80808023",
    "graphics.gridMajor": "#8080805A",
    "graphics.outline": "#FFFFFFA0",
    "graphics.thumbFrame": "#00000040",
    "graphics.thumbSelected": "#000000C0",
    "graphics.stepSelected": "#E08A00E6",
    "graphics.locked": "#0000006E",
    "graphics.lockedHatch": "#FFFFFF1E",
    "graphics.asymmetric": "#E0A040",
    "graphics.p0": "#A86E00",
    "graphics.p1": "#1E7FD0",
    "graphics.m0": "#C25E00",
    "graphics.m1": "#2A5CC0",
    "graphics.bl": "#3C8A2A"
  },
  "indent": [
    "#FFD70030",
    "#8BC34A26",
    "#FF8A6526",
    "#64A0E626"
  ]
}

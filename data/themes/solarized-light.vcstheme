{
  "vcstheme": 1,
  "name": "Solarized Light",
  "palette": {
    "base03": "#002B36",
    "base02": "#073642",
    "base01": "#586E75",
    "base00": "#657B83",
    "base0": "#839496",
    "base1": "#93A1A1",
    "base2": "#EEE8D5",
    "base3": "#FDF6E3",
    "yellow": "#B58900",
    "orange": "#CB4B16",
    "red": "#DC322F",
    "magenta": "#D33682",
    "violet": "#6C71C4",
    "blue": "#268BD2",
    "cyan": "#2AA198",
    "green": "#859900",
    "bg": "$base3",
    "bgHi": "$base2",
    "fg": "$base00",
    "fgEm": "$base01",
    "dim": "$base1",
    "shade": "#000000"
  },
  "colours": {
    "ui.background": "$bg",
    "ui.panel": "$bgHi",
    "ui.popup": "$bg",
    "ui.text": "$fgEm",
    "ui.textDim": "$dim",
    "ui.border": "$dim/60",
    "ui.frame": "$bgHi",
    "ui.frameHover": "$blue/30",
    "ui.frameActive": "$blue/50",
    "ui.title": "$bgHi",
    "ui.titleActive": "$bgHi",
    "ui.button": "$bgHi",
    "ui.buttonHover": "$blue/40",
    "ui.buttonActive": "$blue/70",
    "ui.header": "$blue/30",
    "ui.headerHover": "$blue/48",
    "ui.headerActive": "$blue/68",
    "ui.tab": "$bgHi",
    "ui.tabSelected": "$bg",
    "ui.tabHover": "$blue/30",
    "ui.accent": "$blue",
    "ui.accentHover": "$cyan",
    "ui.scrollbar": "$bgHi/80",
    "ui.scrollbarGrab": "$dim/90",
    "ui.scrollbarGrabHover": "$fg",
    "ui.tableHeader": "$bgHi",
    "ui.tableRowAlt": "$fg/10",
    "ui.link": "$blue",
    "ui.selection": "$blue/40",
    "ui.dockPreview": "$blue/80",
    "ui.modalDim": "$base03/50",
    "editor.background": "$bg",
    "editor.text": "$fg",
    "editor.currentLine": "$bgHi",
    "editor.selection": "$blue/30",
    "editor.cursor": "$fgEm",
    "editor.match": "$yellow/40",
    "editor.matchCurrent": "$orange/60",
    "editor.errorLine": "$red/28",
    "editor.warningLine": "$yellow/30",
    "editor.gutter": "$bg",
    "editor.gutterBorder": "$bgHi",
    "editor.lineNumber": "$dim",
    "editor.lineNumberCurrent": "$fgEm",
    "editor.errorNumber": "$red",
    "editor.warningNumber": "$yellow",
    "editor.breakpoint": "$red",
    "editor.cycles": "$dim",
    "editor.indentGuide": "$dim/60",
    "editor.link": "$blue",
    "syntax.comment": "$dim",
    "syntax.string": "$cyan",
    "syntax.number": "$magenta",
    "syntax.mnemonic": "$blue",
    "syntax.illegal": "$violet",
    "syntax.unstable": "$red",
    "syntax.register": "$yellow",
    "syntax.directive": "$green",
    "syntax.label": "$orange",
    "syntax.symbol": "@editor.text",
    "messages.error": "$red",
    "messages.warning": "$yellow",
    "messages.info": "$blue",
    "messages.ok": "$green",
    "messages.highlight": "$orange",
    "messages.name": "$cyan",
    "space.ok": "$green",
    "space.warning": "$yellow",
    "space.full": "$red",
    "graphics.grid": "#80808023",
    "graphics.gridMajor": "#8080805A",
    "graphics.outline": "#FFFFFFA0",
    "graphics.thumbFrame": "$dim/80",
    "graphics.thumbSelected": "$fgEm",
    "graphics.stepSelected": "$orange",
    "graphics.locked": "#0000006E",
    "graphics.lockedHatch": "#FFFFFF1E",
    "graphics.asymmetric": "$orange/90",
    "graphics.p0": "$yellow",
    "graphics.p1": "$blue",
    "graphics.m0": "$orange",
    "graphics.m1": "$violet",
    "graphics.bl": "$green"
  },
  "indent": [
    "$yellow/1C",
    "$green/1C",
    "$red/14",
    "$blue/14"
  ]
}

1 REM {{NAME}} - VCSIDE The Game in TinyELF Basic (CC0: use and change it freely)
2 REM The joystick or the cursor keys move the hero (a key keeps it walking,
3 REM RETURN stops it); fire or SPACE shoots the way it faces. Walls and blocks
4 REM stop the hero and the shot; the two enemies walk diagonally and bounce.
5 REM A shot enemy scores a point; when both are gone, two more come. Touching
6 REM one costs a life; after the third, back to the title.
7 REM GRAPHICS 8: a sprite is bytes POKEd into video RAM (4096+line*20+byte,
8 REM 8 pixels a byte); the walls are the playfield (128+row*8), mirrored.
9 REM Names (TinyELF reads two letters): HX,HY hero, HD faces left, EX EY EU EV
10 REM EA enemies, SB SY SD shot, SR score, LV lives, GL GR sprite bytes (four
11 REM shifts), WM the room's walls, PC playfield column of x, MC..NV the song.
100 PRINT "VCSIDE THE GAME: PLEASE WAIT"
101 REM names are looked up from the newest to the oldest: the busy ones come last
103 B=0: F=0: H=0: J=0: M=0: O=0: W=0: SR=0: LV=0: HC=0: KX=0: KY=0: EB=0: EC=0: EL=0: ES=0: FL=0: TK=0: SV=0: DE=0: EN=0: HB=0: HD=0: HF=0
104 DX=0: DY=0: TN=0: TL=0: U=0: Z=0: DIM ET(2): NE=0: SB=0: SD=0: SY=0: EF=0: MS=0: T=0: V=0: DIM TB(5,18): DIM R$(40): DIM JX(16): DIM JY(16): DIM FX(6): DIM VX(6)
105 DIM MC(64): DIM MF(64): DIM MV(64): DIM NC(64): DIM NF(64): DIM NV(64): N=0: HX=0: HY=0: K=0: E=0: S=0: R=0: Q=0: P=0: BL=0: X=0: Y=0
106 DIM WM(40,11): DIM PC(145): DIM XB(138,11): DIM EA(2): DIM EU(2): DIM EV(2): DIM EY(2): DIM EX(2): HE=0: BI=0: NX=0: NY=0: OX=0: OY=0: OC=0: IZ=0: C=0: L=0
107 DIM GR(360): DIM GL(360): I=0: A=0
120 FOR F=0 TO 4: H=12: IF F>2 THEN H=8
125 FOR L=1 TO H: READ V: M=0: FOR B=0 TO 7: IF V AND (1<<B) THEN M=M OR (128>>B)
130 NEXT B
135 FOR O=0 TO 3: S=2*O: IF F<3 THEN I=F*48+O*12+L: GL(I)=V>>S: GR(I)=(V<<(8-S)) AND 255: I=I+144: GL(I)=M>>S: GR(I)=(M<<(8-S)) AND 255
140 IF F>2 THEN I=288+(F-3)*32+O*8+L: GL(I)=V>>S: GR(I)=(V<<(8-S)) AND 255
145 NEXT O: NEXT L: NEXT F
150 FOR T=1 TO 64: READ P,Q: MC(T)=P/512: MF(T)=(P/16)%32: MV(T)=P%16
155 NC(T)=Q/512: NF(T)=(Q/16)%32: NV(T)=Q%16: NEXT T
160 FOR T=1 TO 6: READ FX(T),VX(T): NEXT T
164 REM PC: the playfield column of pixel x (+1); byte 16 counts as wall (the kernel echoes it)
165 FOR X=0 TO 144: PC(X+1)=(X*100+550)/386+1: IF X>127 THEN PC(X+1)=40
166 NEXT X
170 FOR S=0 TO 15: IF (S AND 4)=0 THEN JX(S+1)=-2
172 IF (S AND 8)=0 THEN JX(S+1)=2
174 IF (S AND 1)=0 THEN JY(S+1)=-3
176 IF (S AND 2)=0 THEN JY(S+1)=3
178 IF (S AND 12)=0 THEN JX(S+1)=0: JY(S+1)=0
180 NEXT S
182 FOR R=1 TO 11: READ R$: FOR C=1 TO 40: WM(C,R)=(MID$(R$,C,1)="X") OR (C<5) OR (C>36): NEXT C: NEXT R
184 FOR R=1 TO 5: READ R$: FOR C=2 TO 40: IF MID$(R$,C,1)="X" THEN J=C/2: TB(R,J)=TB(R,J) OR (240>>(4*((C-2)%2)))
186 NEXT C: NEXT R
187 REM XB: is a box 8 pixels wide from pixel x (+1) in a wall on text row r?
188 FOR R=1 TO 11: FOR X=0 TO 137: XB(X+1,R)=WM(PC(X+1),R) OR WM(PC(X+8),R): NEXT X: NEXT R
190 HC=30: FOR I=0 TO 181: POKE 1024+I,0: NEXT I: FOR R=11 TO 13: POKE 256+R,14: NEXT R
200 REM ---- title screen ----
205 GRAPHICS 8: POKE 25,0: POKE 26,0: MS=0: EF=0
210 FOR R=1 TO 5: POKE 256+R+1,156: FOR J=2 TO 17: V=TB(R,J): IF V THEN A=4096+(R+1)*240+J: FOR L=1 TO 12: POKE A,V: A=A+20: NEXT L
215 NEXT J: NEXT R: NY=24: HE=60: GOSUB 762
220 POKE 256+8,HC: POKE 256+9,70: HE=12: OX=56: OY=96: NX=OX: NY=OY: BI=0: GOSUB 702
225 HE=8: OX=76: OY=110: NX=OX: NY=OY: BI=288: GOSUB 702: OX=92: NX=OX: BI=320: GOSUB 702
230 LOCATE 3,12: PRINT "VCSIDE THE GAME IN TINYELF BASIC";
235 LOCATE 8,14: PRINT "FIRE OR SPACE TO PLAY";
240 GOSUB 602: GET K: IF (STRIG(0)=0) OR (K=32) OR (K=13) THEN GOTO 305
245 GOTO 240
300 REM ---- a new game ----
305 SR=0: LV=3
310 GRAPHICS 8: MS=0: EF=0
315 FOR R=1 TO 11: B=120+R*8: POKE B,52: POKE B+1,5: P=0: Q=0: S=0
320 FOR C=1 TO 20: IF WM(C,R) AND (C>4) THEN GOSUB 380
325 NEXT C: POKE B+2,P: POKE B+3,Q: POKE B+4,S: POKE B+5,P: POKE B+6,Q: POKE B+7,S: NEXT R
330 HX=66: HY=96: HD=0: HF=0: HB=-1: NE=1: SD=0: KX=0: KY=0: FL=1: EN=1: TL=MILLIS(33): ET(1)=TL: ET(2)=TL: GOSUB 852
335 LOCATE 2,12: PRINT "SCORE ";SR;: LOCATE 28,12: PRINT "LIVES ";LV;
340 GOTO 405
380 IF C<5 THEN P=P OR (16<<(C-1)): RETURN
382 IF C<13 THEN Q=Q OR (128>>(C-5)): RETURN
384 S=S OR (1<<(C-13)): RETURN
400 REM ---- the game loop: N ticks of 2 frames since the last turn (4 at most) ----
405 GOSUB 602: TN=MILLIS(33): N=TN-TL: TL=TN: IF N>4 THEN N=4
406 S=STICK(0)+1: GET K: DX=JX(S): DY=JY(S): IF K THEN GOSUB 683
410 IF S=16 THEN DX=KX: DY=KY
435 NX=HX: NY=HY: HE=12: IF DX THEN GOSUB 670
440 IF DY THEN GOSUB 676
445 IF DX<0 THEN HD=1
447 IF DX>0 THEN HD=0
450 W=0: IF (NX<>HX) OR (NY<>HY) THEN HF=(HF+1)%4: W=-(HF=1)-2*(HF=3)
455 BI=(HD*3+W)*48: IF (BI<>HB) OR (NX<>HX) OR (NY<>HY) OR NE THEN OX=HX: OY=HY: HE=12: HB=BI: GOSUB 702
460 HX=NX: HY=NY: Z=(N+1)/2: IF SD=0 THEN Z=0
462 IF Z THEN GOSUB 552
464 IF Z>1 THEN IF SD THEN GOSUB 552
470 F=(STRIG(0)=0): IF (F AND (FL=0)) OR (K=32) THEN IF SD=0 THEN GOSUB 532
475 FL=F: EN=3-EN: IF EA(EN) THEN E=EN: GOSUB 642
480 POKE 256+HY/12,HC: POKE 256+(HY+11)/12,HC: DE=0: NE=0
485 FOR E=1 TO 2: IF EA(E) THEN X=ABS(HX-EX(E)): IF X<24 THEN GOSUB 680
490 NEXT E: IF DE THEN GOTO 802
495 GOTO 405
530 REM fire: the shot starts beside the hero, in the way it faces
532 SD=1-2*HD: SB=HX/8+2: SV=240: IF HD THEN SB=HX/8-1: SV=15
534 SY=HY+5: IF WM(PC(SB*8+3),SY/12+1) THEN SD=0: RETURN
536 A=4096+SY*20+SB: POKE A,SV: POKE A+20,SV
538 EF=1: ES=MILLIS(50): EB=1: EL=4: EC=4: GOTO 555
550 REM the shot moves a byte (8 pixels) every two ticks and stops at walls and blocks
552 A=4096+SY*20+SB: POKE A,0: POKE A+20,0: SB=SB+SD: IF WM(PC(SB*8+3),SY/12+1) THEN SD=0: RETURN
555 FOR E=1 TO 2: IF SD THEN IF EA(E) THEN IF (SB>=EX(E)/8) AND (SB<=(EX(E)+7)/8) AND (SY+2>EY(E)) AND (SY<EY(E)+8) THEN GOSUB 582
560 NEXT E: IF SD THEN A=4096+SY*20+SB: POKE A,SV: POKE A+20,SV
565 RETURN
580 REM an enemy is shot
582 A=4096+SY*20+SB: POKE A,0: POKE A+20,0
584 OX=EX(E): OY=EY(E): HE=8: GOSUB 782: EA(E)=0: SD=0: SR=SR+1: LOCATE 8,12: PRINT SR;
586 EF=1: ES=MILLIS(50): EB=5: EL=2: EC=15
588 IF (EA(1)=0) AND (EA(2)=0) THEN GOSUB 852
590 RETURN
600 REM music: one row of the song every 100 ms; an effect takes channel 1
602 T=MILLIS(100)%64+1: IF T<>MS THEN GOSUB 610
604 IF EF THEN GOSUB 616
608 RETURN
610 MS=T: POKE 21,MC(T): POKE 23,MF(T): POKE 25,MV(T): IF EF=0 THEN POKE 22,NC(T): POKE 24,NF(T): POKE 26,NV(T)
612 RETURN
616 TK=MILLIS(50)-ES: IF TK<EL THEN POKE 22,EC: POKE 24,FX(EB+TK): POKE 26,VX(EB+TK): RETURN
618 EF=0: MS=0: RETURN
640 REM enemy E walks diagonally, a pixel and a line a tick, and bounces off walls and blocks
642 HE=8: U=TL-ET(E): ET(E)=TL: IF U>6 THEN U=6
643 NX=EX(E)+EU(E)*U: X=NX: Y=EY(E): GOSUB 902: IF BL THEN NX=EX(E)+EU(E): X=NX: GOSUB 902
644 IF BL THEN EU(E)=-EU(E): NX=EX(E)
645 NY=EY(E)+EV(E)*U: X=NX: Y=NY: GOSUB 902: IF BL THEN NY=EY(E)+EV(E): Y=NY: GOSUB 902
646 IF BL THEN EV(E)=-EV(E): NY=EY(E)
647 OX=EX(E): OY=EY(E): EX(E)=NX: EY(E)=NY: BI=288+32*(MILLIS(250)%2): GOSUB 702
648 POKE 256+NY/12,6+64*E: POKE 256+(NY+7)/12,6+64*E: RETURN
670 X=HX+DX*N: Y=HY: GOSUB 902: IF BL THEN X=HX+DX: GOSUB 902
672 IF BL=0 THEN NX=X
674 RETURN
676 X=NX: Y=HY+DY*N: GOSUB 902: IF BL THEN Y=HY+DY: GOSUB 902
678 IF BL=0 THEN NY=Y
679 RETURN
680 Y=EY(E)-HY: IF (Y>-9) AND (Y<13) THEN NE=1: IF (X<7) AND (Y>-7) AND (Y<11) THEN DE=1
682 RETURN
683 IF K=8 THEN KX=-2: KY=0
684 IF K=21 THEN KX=2: KY=0
685 IF K=11 THEN KX=0: KY=-3
686 IF K=10 THEN KX=0: KY=3
687 IF K=13 THEN KX=0: KY=0
688 RETURN
700 REM draw a sprite at NX,NY (old place OX,OY): HE lines from GL/GR after BI
702 C=NX/8: I=BI+(NX%8)/2*HE: A=4096+NY*20+C: IZ=I+HE
704 FOR I=I+1 TO IZ: POKE A,GL(I): POKE A+1,GR(I): A=A+20: NEXT I
706 OC=OX/8: IF C<>OC THEN GOSUB 720
710 IF NY<>OY THEN GOSUB 730
714 IF (C<3) OR (OC<3) THEN GOSUB 762
716 RETURN
720 A=4096+OY*20+OC: IF C<OC THEN A=A+1
722 FOR L=1 TO HE: POKE A,0: A=A+20: NEXT L: RETURN
730 IZ=NY-OY: A=4096+OY*20+OC: IF NY<OY THEN IZ=-IZ: A=4096+(NY+HE)*20+OC
732 FOR L=1 TO IZ: POKE A,0: POKE A+1,0: A=A+20: NEXT L: RETURN
760 REM the kernel shows the left five pixels of byte 2 from byte 18
762 A=4096+(NY-12)*20: FOR L=1 TO HE+24: POKE A+18,PEEK(A+2) AND 248: A=A+20: NEXT L: RETURN
780 REM erase a sprite at OX,OY
782 A=4096+OY*20+OX/8: FOR L=1 TO HE: POKE A,0: POKE A+1,0: A=A+20: NEXT L: NY=OY: IF OX<24 THEN GOSUB 762
784 RETURN
800 REM the hero is caught: the lose sound, then a life less
802 POKE 26,0: FOR K=0 TO 11: POKE 21,12: POKE 23,10+3*K/2: V=12: IF 3*K>16 THEN V=12-(3*K-16)/2
804 POKE 25,V: DELAY 50: NEXT K: POKE 25,0
806 LV=LV-1: IF LV>0 THEN GOTO 310
808 LOCATE 14,13: PRINT "GAME OVER";: DELAY 2000: GOTO 205
850 REM two enemies in the top corners
852 EX(1)=20: EY(1)=14: EU(1)=1: EV(1)=1: EA(1)=1: EX(2)=112: EY(2)=14: EU(2)=-1: EV(2)=1: EA(2)=1
854 FOR J=1 TO 2: OX=EX(J): OY=EY(J): NX=OX: NY=OY: HE=8: BI=288: GOSUB 702: NEXT J: RETURN
900 REM is the box at X,Y (8 wide, HE tall) in a wall or block? BL<>0 if so
902 BL=XB(X+1,Y/12+1) OR XB(X+1,(Y+HE-1)/12+1): RETURN
1000 REM hero: stand, walk 1, walk 2 (12 rows each, bit 7 = left pixel)
1001 DATA 28,62,52,60,24,126,189,189,60,36,36,102
1002 DATA 28,62,52,60,24,126,188,61,60,68,132,198
1003 DATA 28,62,52,60,24,126,61,188,60,34,33,99
1004 REM enemy: two frames of 8 rows
1005 DATA 60,126,219,255,255,90,129,66
1006 DATA 60,126,219,255,255,90,66,129
1007 REM the song: a 100 ms row per pair, channel 0 and 1 as AUDC*512+AUDF*16+AUDV
1008 DATA 2490,741,2486,740,2486,740,2486,740,2426,4183
1009 DATA 2422,0,2422,0,2422,0,2346,741,2342,740
1010 DATA 2342,740,2342,740,2378,4183,2374,0,2426,0
1011 DATA 2422,0,2442,773,2438,772,2438,772,2438,772
1012 DATA 2554,4183,2550,0,2550,0,2550,0,2490,821
1013 DATA 2486,820,2486,820,2486,820,2483,4183,0,0
1014 DATA 0,4183,0,0,6330,805,6326,804,6326,804
1015 DATA 6326,804,2490,4183,2486,0,2486,0,2486,0
1016 DATA 2426,805,2422,804,2422,804,2422,804,2442,4183
1017 DATA 2438,0,2438,0,2438,0,2554,773,2550,772
1018 DATA 2550,772,2550,772,2442,4183,2438,0,2378,0
1019 DATA 2374,0,2346,821,2342,820,2342,820,2342,820
1020 DATA 2342,4183,2342,0,2339,4183,0,0
1021 REM effects, AUDF and AUDV per 50 ms: the shot (4 steps), the hit (2)
1022 DATA 23,12,16,9,11,6,11,3,24,12,28,6
1023 REM the room, as in room.vcsgfx: 40 playfield columns, the right half mirrored
1024 DATA "....XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX...."
1025 DATA "....X..............................X...."
1026 DATA "....X..............................X...."
1027 DATA "....X...XXXX................XXXX...X...."
1028 DATA "....X..............................X...."
1029 DATA "....X..........XXXXXXXXXX..........X...."
1030 DATA "....X..............................X...."
1031 DATA "....X...XXXX................XXXX...X...."
1032 DATA "....X..............................X...."
1033 DATA "....X..............................X...."
1034 DATA "....XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX...."
1035 REM THE GAME, as in title.vcsgfx
1036 DATA ".....XXX.X.X.XXX.....XX..X..X.X.XXX....."
1037 DATA "......X..X.X.X......X...X.X.XXX.X......."
1038 DATA "......X..XXX.XX.....X.X.XXX.XXX.XX......"
1039 DATA "......X..X.X.X......X.X.X.X.X.X.X......."
1040 DATA "......X..X.X.XXX.....XX.X.X.X.X.XXX....."

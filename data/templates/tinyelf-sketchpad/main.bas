10 REM SKETCH PAD - an autorun demo for TinyELF Basic
20 REM cursor keys or joystick 0 draw, RETURN or fire starts a new page
30 REM lower the frame budget so the colour loop keeps the TV in sync
40 POKE 653,0: POKE 652,100
50 X=20: Y=5: C=0
60 GOSUB 300
100 PLOT X,Y
110 GET K: H=0: V=0
120 IF K=11 THEN V=-1
130 IF K=10 THEN V=1
140 IF K=8 THEN H=-1
150 IF K=21 THEN H=1
160 IF K=13 OR STRIG(0)=0 THEN GOSUB 300: GOTO 100
170 REM a held key shows up in STICK too, as left and right at once
180 S=STICK(0)
190 IF K>0 OR S/4%4=0 THEN GOTO 240
200 IF S%2=0 THEN V=-1
210 IF S/2%2=0 THEN V=1
220 IF S/4%2=0 THEN H=-1
230 IF S/8%2=0 THEN H=1
240 X=X+H: Y=Y+V
250 IF X<0 THEN X=0
260 IF X>39 THEN X=39
270 IF Y<0 THEN Y=0
280 IF Y>10 THEN Y=10
290 DELAY 60: GOTO 100
300 REM new page: clear, next colour, a short beep
310 GRAPHICS 3
320 C=C%7+1: FOR I=0 TO 142: POKE 1024+I,C*32+2: NEXT I
330 LOCATE 1,12: PRINT "SKETCH PAD"
340 PRINT "CURSOR KEYS/STICK DRAW, RETURN/FIRE NEW PAGE";
350 POKE 21,4: POKE 23,12: POKE 25,8: DELAY 80: POKE 25,0
360 IF STRIG(0)=0 THEN GOTO 360
370 RETURN
